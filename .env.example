# Copy of the supported API setting names; never add real secrets to this template.
# Base URL includes /v1 (or your provider's prefix), not /chat/completions.
USER_API_BASE=
USER_MODEL=
USER_API_KEY=

CHARACTER_API_BASE=
CHARACTER_MODEL=
CHARACTER_API_KEY=

# User, Character and reviewer call models; legacy director/judge settings are unused.
# Existing process environment variables take precedence over .env.

# Optional reviewer endpoint: leave all three empty to reuse User API settings.
# If overriding, set all three values.
REVIEWER_API_BASE=
REVIEWER_MODEL=
REVIEWER_API_KEY=
